{
  "functions": {
    "source": "functions",
    "secrets": [
      "CHANNEL_ACCESS_TOKEN_PROD",
      "CHANNEL_SECRET_PROD",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY_PROD",
      "SUPABASE_TABLE_NAME_PROD",
      "MY_LINE_USER_ID",
      "NODE_ENV"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "webhook"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=5184000"
          }
        ]
      }
    ]
  }
}
