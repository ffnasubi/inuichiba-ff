{
  "functions": {
    "source": "functions",
    "region": "asia-northeast1",
    "secrets": [
      "NODE_ENV",
      "CHANNEL_SECRET_PROD",
      "CHANNEL_ACCESS_TOKEN_PROD",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY_PROD",
      "SUPABASE_TABLE_NAME_PROD"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "webhook"
      }
    ]
  }
}
