{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "region": "asia-northeast1"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "webhook"
      }
    ]
  }
}
