{
  "functions": {
    "source": "functions",
    "region": "asia-northeast1",
    "secrets": [
      "NODE_ENV",
      "CHANNEL_SECRET_DEV",
      "CHANNEL_ACCESS_TOKEN_DEV",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY_DEV",
      "SUPABASE_TABLE_NAME_DEV"
    ]

  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "webhook"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=5184000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(json|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      }
    ]
  }
}
  